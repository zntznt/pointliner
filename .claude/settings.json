{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-pr-conformance.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.*github.*__(create|update)_pull_request$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-pr-conformance.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
